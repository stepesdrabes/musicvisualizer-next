{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "LightningStrike",
	"version": "0.1.0",
	"identifier": "cz.drabek.lightningstrike",
	"build": {
		"frontendDist": "../splash"
	},
	"app": {
		"withGlobalTauri": false,
		"macOSPrivateApi": true,
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app", "dmg"],
		"icon": ["icons/icon.icns", "icons/128x128.png", "icons/32x32.png"],
		"externalBin": ["binaries/node"],
		"resources": {
			"../../web/build": "server",
			"../../../models": "models",
			"runtime/node_modules": "server/node_modules"
		},
		"macOS": {
			"minimumSystemVersion": "11.0"
		}
	}
}
